quickfixit-backend/*.tar.gz

# Model weights - only keep fine-tuned best.pt
quickfixit-backend/yolov8n.pt
quickfixit-backend/models/pothole_yolov8/weights/last.pt
quickfixit-backend/models/pothole_yolov8/events.out.tfevents.*

