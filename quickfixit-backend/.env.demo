# ── Demo / Local Dev (no Docker needed) ──────────────────────────────────────
APP_ENV=demo
DEBUG=true
SECRET_KEY=demo-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# SQLite — no PostgreSQL needed
DATABASE_URL=sqlite+aiosqlite:///./quickfixit_demo.db

# Local filesystem — no MinIO needed
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploaded_photos

# No Redis/Celery — verification runs inline
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Verification thresholds
GPS_TOLERANCE_METERS=20.0
HEADING_TOLERANCE_DEGREES=30.0
TILT_TOLERANCE_DEGREES=20.0
LANDMARK_MIN_MATCHES=15
LANDMARK_MIN_INLIER_RATIO=0.35
PHASH_HAMMING_THRESHOLD=8
FUSION_AUTO_PASS=0.80
FUSION_OFFICER_REVIEW=0.50

# YOLO model (pretrained — no training needed for basic demo)
YOLO_MODEL_PATH=yolov8n-seg.pt

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
