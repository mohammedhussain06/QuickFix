# ─────────────────────────────────────────────────────────────────────────────
# QuickFix It — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development              # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=quickfixit
POSTGRES_PASSWORD=quickfixit_secret
POSTGRES_DB=quickfixit
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://quickfixit:quickfixit_secret@db:5432/quickfixit

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET_PHOTOS=quickfixit-photos
MINIO_USE_SSL=false

# ── Verification Pipeline Thresholds (tunable without redeployment) ───────────
GPS_TOLERANCE_METERS=20.0       # Step 2: max allowed distance between before/after GPS
HEADING_TOLERANCE_DEGREES=30.0  # Step 3: max compass heading difference
TILT_TOLERANCE_DEGREES=20.0     # Step 3: max phone tilt difference
LANDMARK_MIN_MATCHES=15         # Step 4: minimum ORB/SIFT good matches
LANDMARK_MIN_INLIER_RATIO=0.35  # Step 4: minimum RANSAC inlier ratio
PHASH_HAMMING_THRESHOLD=8       # Step 1: Hamming distance for duplicate detection
FUSION_AUTO_PASS=0.80           # Step 6: score >= this → auto_pass
FUSION_OFFICER_REVIEW=0.50      # Step 6: score >= this → officer_review, else auto_reject

# ── YOLO Model & Hugging Face Hub ──────────────────────────────────────────────
YOLO_MODEL_PATH=models/pothole_yolov8/weights/best.pt   # local weights path
HF_MODEL_REPO=RoxieRoller/QuickFixIt-model              # Hugging Face Hub model repo (auto-downloads if local missing)

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
